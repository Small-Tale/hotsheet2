# --- Hot Sheet local data ---
# `.hotsheet/` belongs to HS1. HS2 keeps its checkout-local files separate so both
# applications can operate in one repository without overwriting each other.
/.hotsheet/
# HS2 project metadata is local except for the shared project settings file.
/.hotsheet2/*
!/.hotsheet2/settings.json

# --- Claude Code / AI-tool local + harness files ---
/.claude/settings.local.json
/.codex/config.local.toml
.cc-writes/
/.agents/**/settings.local.json

# --- MCP config: carries machine-specific absolute paths ---
/.mcp.json

# --- Secrets / certificates (never commit) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secret.json

# --- Rust build output (future core/server/CLI) ---
/target/
**/target/

# --- Node (bundled migrator + any tooling) ---
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Common build/test/coverage output ---
/dist/
**/dist/
/coverage/
coverage/
/test-results/
**/test-results/
/playwright-report/
**/playwright-report/
.nyc_output/

# --- Diagram scratch (committed SVGs stay; local PNG previews don't) ---
docs/diagrams/**/*.png

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.hotsheet2/store

/.glassbox/*
!/.glassbox/settings.json
.hotsheet2/settings.local.json
