# --- Hot Sheet local data ---
# `.hotsheet/` belongs to HS1. HS2 keeps its checkout-local files separate so both
# applications can operate in one repository without overwriting each other.
/.hotsheet/
/.hs2-recovery/
# HS2 project metadata is local except for the shared project settings file and the
# project group registry, one committed file per group (HS2-9KZSD4). Hot Sheet owns
# the block below and restores it when it writes into `.hotsheet2/` (HS2-61ZMVA).
# >>> Hot Sheet 2 (managed; edit outside this block) >>>
/.hotsheet2/*
!/.hotsheet2/settings.json
!/.hotsheet2/groups/
# <<< Hot Sheet 2 <<<

# --- Claude Code / AI-tool local + harness files ---
/.claude/settings.local.json
/.claude/worktrees/
/.codex/config.local.toml
.cc-writes/
/.agents/**/settings.local.json

# --- MCP config: carries machine-specific absolute paths ---
/.mcp.json

# --- Secrets / certificates (never commit) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secret.json

# --- Rust build output (future core/server/CLI) ---
/target
**/target

# --- Node (bundled migrator + any tooling) ---
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Common build/test/coverage output ---
/dist/
**/dist/
**/dist-host/
/coverage/
coverage/
/test-results/
**/test-results/
/playwright-report/
**/playwright-report/
**/blob-report/
**/all-blob-reports/
**/.kerf-cache/
**/kerf-ui-evidence/
.nyc_output/

# --- Diagram scratch (committed SVGs stay; local PNG previews don't) ---
docs/diagrams/**/*.png

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

/.glassbox/*
!/.glassbox/settings.json
/.rulesync/rules/.curated/
/scripts/.*
