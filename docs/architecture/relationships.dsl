contributorUsesHs2 = developer -> hs2 "Manages project tickets and runs work" "Browser / terminal"
operatorManagesHs2 = operator -> hs2 "Configures projects, access, and execution" "Browser / terminal"
hs2UsesTools = hs2 -> aiTool "Launches and drives supported sessions" "Process launch / tool-specific protocol"
toolsUseHs2 = aiTool -> hs2 "Uses ticket, claim, and coordination tools" "MCP / local hooks"
hs2UsesGit = hs2 -> gitRemote "Synchronizes ticket repositories and inspects code revisions" "Git"
hs2UsesGithub = hs2 -> github "Reads or updates Issues and observes supported Actions jobs" "HTTPS"
githubNotifiesHs2 = github -> hs2 "Delivers configured repository events" "Webhook"
hs2UsesGitlab = hs2 -> gitlab "Reads or updates Issues and observes supported CI jobs" "HTTPS"
hs2UsesJira = hs2 -> jira "Reads and updates issues" "HTTPS"
hs2UsesCi = hs2 -> ciServices "Observes supported CI jobs" "HTTPS"
hs2SendsNotifications = hs2 -> notifierServices "Delivers configured notices" "Configured notifier protocols"
hs2UsesSharedClaims = hs2 -> sharedClaims "Acquires or observes configured shared resource leases" "HTTPS / subprocess adapter"
hs2UsesOs = hs2 -> osServices "Uses local processes, file events, terminals, and native secret storage" "Native OS APIs"
hs2ReadsLegacy = hs2 -> legacy "Imports a legacy project from a copied database" "Filesystem / PGLite"

contributorUsesWeb = developer -> web "Uses the workspace" "Web UI"
contributorUsesCli = developer -> cli "Runs headless commands" "Terminal"
contributorUsesDesktop = developer -> desktop "Opens the installed application" "Native window"
operatorUsesWeb = operator -> web "Manages projects, devices, and policy" "Web UI"
desktopLaunchesBridge = desktop -> bridge "Starts the bundled host and loads its local origin" "Child process / HTTP"
webCallsBridge = web -> bridge "Requests project operations and opens live streams" "HTTP / WebSocket"
bridgeDeliversWebEvents = bridge -> web "Forwards live changes and terminal output" "WebSocket / HTTP"
bridgeCallsServer = bridge -> server "Opens checkouts and forwards scoped requests and streams" "HTTP(S) / WebSocket"
serverDeliversBridgeEvents = server -> bridge "Supplies replayable changes and terminal output" "WebSocket / HTTP"
bridgeRunsCli = bridge -> cli "Runs headless setup and server lifecycle operations" "Child process"
cliCallsServer = cli -> server "Starts, discovers, or calls the host when required" "Child process / HTTP(S)"
serverRunsCli = server -> cli "Runs supported setup, job, and orchestration commands" "Child process"
toolCallsMcp = aiTool -> mcp "Invokes checkout tools" "stdio JSON-RPC"
mcpCallsServer = mcp -> server "Uses the launched or explicit server route and reports presence" "HTTP"
mcpCallsGitStore = mcp -> tickets "Reads and changes a direct store in serverless mode" "Filesystem / Git"
cliCallsGitStore = cli -> tickets "Runs direct store operations, including writes and local claims" "Filesystem / Git"
cliCallsIndex = cli -> searchIndex "Queries or explicitly rebuilds the local projection" "SQLite"
cliUsesGithub = cli -> github "Runs supported provider and CI operations" "HTTPS"
cliUsesGitlab = cli -> gitlab "Runs supported provider and CI operations" "HTTPS"
cliUsesJira = cli -> jira "Runs supported provider operations" "HTTPS"
serverCallsGitStore = server -> tickets "Reads, writes, watches, and reconciles a linked store" "Filesystem / Git"
serverCallsIndex = server -> searchIndex "Updates and queries local indexed pages and counts" "SQLite"
serverUsesGithub = server -> github "Routes native Issues requests and observes supported Actions jobs" "HTTPS"
githubNotifiesServer = github -> server "Delivers configured repository events" "Webhook"
serverUsesGitlab = server -> gitlab "Routes native Issues requests and observes supported CI jobs" "HTTPS"
serverUsesJira = server -> jira "Routes native issue and advisory claim operations" "HTTPS"
serverSyncsGit = server -> gitRemote "Fetches and publishes eligible linked store changes" "Git"
cliSyncsGit = cli -> gitRemote "Initializes, links, and syncs repositories on request" "Git"
serverReadsCheckout = server -> checkoutData "Reads source and settings, persists local command schedules, and observes checked-in plan changes" "Filesystem / Git"
cliReadsCheckout = cli -> checkoutData "Resolves checkout and source bindings, configures guidance, and reads or edits policy" "Filesystem / Git"
bridgeReadsCheckout = bridge -> checkoutData "Discovers and opens local projects through the host" "Filesystem"
bridgeUsesMachine = bridge -> machineData "Resolves instances and persists desktop bridge preferences and staged drafts" "Local files"
serverUsesMachine = server -> machineData "Persists registries, device grants, jobs, claims, and orchestration observations" "Local files"
cliUsesMachine = cli -> machineData "Reads and administers local registries, credentials, and coordination state" "Local files"
mcpUsesMachine = mcp -> machineData "Discovers the local host and store/source bindings" "Local files"
serverUsesOs = server -> osServices "Uses native file events, credentials, and process facilities" "Native OS APIs"
cliUsesOs = cli -> osServices "Uses native credentials and starts local tools" "Native OS APIs"
serverUsesBroker = server -> broker "Starts or reconnects to detached PTY owners and relays input and output" "Local IPC"
serverUsesRelay = server -> launchRelay "Requests background terminal launch when the relay is available" "Local IPC"
relayLaunchesBroker = launchRelay -> broker "Starts the detached terminal owner when needed" "Process launch"
brokerRunsTool = broker -> aiTool "Hosts interactive AI tools and shell processes" "PTY"
serverDrivesTool = server -> aiTool "Launches or drives provider sessions and receives permission callbacks" "Provider-specific process / local interfaces"
cliRunsTool = cli -> aiTool "Starts compatible tools for headless launch and drive operations" "Process launch"
serverPublishesStandby = server -> standby "Writes bounded display snapshots with no server credential" "File"
saverReadsStandby = saver -> standby "Watches and reads the latest snapshot" "File"
bridgeRunsMigration = bridge -> migrator "Starts the packaged import or migration job" "Child process"
migrationReadsLegacy = migrator -> legacy "Exports from a copy of the old database" "Node.js / PGLite"
migrationWritesStore = migrator -> tickets "Imports normalized tickets, attachments, and mappings and records them in Git" "Filesystem / Git"

workspaceQueriesApi = webWorkspace -> webApi "Requests scoped reads and writes" "TypeScript"
workspaceUsesChanges = webWorkspace -> webChanges "Subscribes to active projects and applies events by cursor" "Worker messages"
apiUsesBridge = webApi -> bridge "Sends scoped API operations" "HTTP(S)"
changesUseBridge = webChanges -> bridge "Subscribes to live changes or reconnects from a cursor" "WebSocket / HTTP long poll"
terminalUsesBridge = webTerminal -> bridge "Attaches terminal input, output, and replay" "WebSocket"

bridgeUsesTrust = bridge -> serverTrust "Presents the appropriate transport and request authority" "HTTP(S) / WebSocket"
trustAdmitsTickets = serverTrust -> serverTickets "Admits a scoped ticket operation" "Rust / Axum"
trustAdmitsTerminal = serverTrust -> serverTerminal "Admits terminal operations and stream attachment" "Rust / Axum"
trustAdmitsOrch = serverTrust -> serverOrch "Admits authorized orchestration actions" "Rust / Axum"
ticketApiUsesSource = serverTickets -> serverSources "Routes by qualified identity and capability" "Rust provider contract"
ticketApiUsesIndex = serverTickets -> serverIndex "Reads local indexed pages and updates affected projections" "Rust / SQLite"
ticketApiPublishes = serverTickets -> serverEvents "Publishes ticket and claim invalidations" "Rust event bus"
sourceWritesGit = serverSources -> tickets "Persists the authoritative local Git operation" "Filesystem / Git"
sourceUsesGithub = serverSources -> github "Delegates native Issues operations" "HTTPS"
sourceUsesGitlab = serverSources -> gitlab "Delegates native Issues operations" "HTTPS"
sourceUsesJira = serverSources -> jira "Routes Jira operations and supported queued writes" "HTTPS"
reconcileReadsGit = serverIndex -> tickets "Observes filesystem edits and reads affected ticket paths" "Filesystem notifications"
reconcileWritesIndex = serverIndex -> searchIndex "Applies changes to SQLite" "SQLite"
reconcilePublishes = serverIndex -> serverEvents "Publishes changes after reconciliation" "Rust event bus"
eventsDeliverBridge = serverEvents -> bridge "Replays or delivers events to subscribed clients" "WebSocket / HTTP long poll"
scheduleReadsSettings = serverSchedule -> checkoutData "Reads schedules and persists occurrence records" "Local settings files"
scheduleUsesTickets = serverSchedule -> serverTickets "Checks the command provenance and creates one Up Next ticket if eligible" "Rust"
scheduleClaimsTicket = serverSchedule -> serverTickets "Claims the exact scheduled ticket for the session worker" "Rust / Git ticket lease"
scheduleHandsOff = serverSchedule -> serverDrive "Requests the selected exact-ticket AI handoff" "Rust"
driveUsesTerminal = serverDrive -> serverTerminal "Launches or uses the eligible terminal and worker identity" "Rust"
driveUsesTool = serverDrive -> aiTool "Sends a supported provider turn and tracks its outcome" "Provider-specific protocol"
terminalUsesBroker = serverTerminal -> broker "Uses detached Unix PTY ownership" "Local IPC"
terminalObservesTool = serverTerminal -> aiTool "Hosts tool processes in the in-process PTY path" "PTY"
orchUsesTrust = serverOrch -> serverTrust "Evaluates operation-specific authorization" "Rust authorization checks"
orchUsesState = serverOrch -> machineData "Reads and writes target, session, gate, and run observations" "Local files"
orchUsesPlan = serverOrch -> checkoutData "Reads shared plan definitions and checkout policy" "Filesystem / Git"
orchUsesTickets = serverOrch -> serverTickets "Observes and links target work and its readiness" "Rust"
orchUsesDrive = serverOrch -> serverDrive "Places or reuses permitted AI sessions" "Rust / authorized host operations"
orchUsesJobs = serverOrch -> serverJobs "Reads or starts supported validation or job operations" "Rust"
jobsUseGithub = serverJobs -> github "Observes supported Actions runs" "HTTPS"
jobsUseGitlab = serverJobs -> gitlab "Observes supported CI runs" "HTTPS"
orchUsesResources = serverOrch -> serverResources "Observes lease availability before placement" "Rust lease service"
resourcesUseMachine = serverResources -> machineData "Persists local backend bindings and leases" "Local files"
resourcesUseRemote = serverResources -> sharedClaims "Uses configured shared leases" "HTTPS / subprocess adapter"
resourcesUseGit = serverResources -> gitRemote "Reads or updates leases in the configured Git ref backend" "Git"
jobsUseCi = serverJobs -> ciServices "Observes configured Buildkite and CircleCI jobs" "HTTPS"
jobsUseMachine = serverJobs -> machineData "Persists job and process observations" "Local files"
notifyUsesEvents = serverNotify -> serverEvents "Publishes workspace notification state" "Rust event bus"
notifySends = serverNotify -> notifierServices "Delivers configured notification events" "Configured notifier protocols"
notifyWritesStandby = serverNotify -> standby "Publishes a bounded projection for the screen saver" "JSON file"
