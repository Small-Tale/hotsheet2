cliPermissionHookServer = cliPermissionHook -> server "Asks /permissions/ask and reports terminal session events" "HTTP"
cliCoordinationOrch = cliCoordination -> orchLib "Applies provisional rules and watches Job records" "Rust call"
cliCoordinationStore = cliCoordination -> tickets "Reads tickets and writes coordination notes" "Filesystem / Git"
cliCoordinationCheckout = cliCoordination -> checkoutData "Keeps the pool under the Git common directory" "Local files / file lock"
cliOrchestrationOrch = cliOrchestration -> orchLib "Runs orchestration domain transitions" "Rust call"
cliOrchestrationMachine = cliOrchestration -> machineData "Reads and writes bindings, journals and validation files" "Local files"
cliOrchestrationServer = cliOrchestration -> server "Starts and inspects hosted sessions on the local server" "HTTP"
cliRemotesServer = cliRemotes -> server "Calls paired remote servers" "HTTPS / mTLS"
cliRemotesMachine = cliRemotes -> machineData "Reads and writes remotes.json" "Local files"
cliJobsOrch = cliJobs -> orchLib "Uses the Job store and watch monitor" "Rust call"
