// Cross-area relationships: an edge whose endpoints belong to two different areas.
// Append-only for area tickets: add new edges at the end under a comment naming
// your ticket; do not reorder, rename or delete another ticket's edges. HS2-M81CCP
// owns final consolidation.

// Baseline (HS2-3FA79J)
webCallsBridge = web -> bridge "Requests project operations and opens live streams" "HTTP / WebSocket"
bridgeDeliversWebEvents = bridge -> web "Forwards live changes and terminal output" "WebSocket / HTTP"
bridgeCallsServer = bridge -> server "Opens checkouts and forwards scoped requests and streams" "HTTP(S) / WebSocket"
serverDeliversBridgeEvents = server -> bridge "Supplies replayable changes and terminal output" "WebSocket / HTTP"
bridgeRunsCli = bridge -> cli "Runs headless setup and server lifecycle operations" "Child process"
cliCallsServer = cli -> server "Starts, discovers, or calls the host when required" "Child process / HTTP(S)"
serverRunsCli = server -> cli "Runs supported setup, job, and orchestration commands" "Child process"
mcpCallsServer = mcp -> server "Uses the launched or explicit server route and reports presence" "HTTP"
mcpCallsGitStore = mcp -> tickets "Reads and changes a direct store in serverless mode" "Filesystem / Git"
cliCallsGitStore = cli -> tickets "Runs direct store operations, including writes and local claims" "Filesystem / Git"
cliCallsIndex = cli -> searchIndex "Queries or explicitly rebuilds the local projection" "SQLite"
serverCallsGitStore = server -> tickets "Reads, writes, watches, and reconciles a linked store" "Filesystem / Git"
serverCallsIndex = server -> searchIndex "Updates and queries local indexed pages and counts" "SQLite"
serverReadsCheckout = server -> checkoutData "Reads source and settings, persists local command schedules, and observes checked-in plan changes" "Filesystem / Git"
cliReadsCheckout = cli -> checkoutData "Resolves checkout and source bindings, configures guidance, and reads or edits policy" "Filesystem / Git"
bridgeReadsCheckout = bridge -> checkoutData "Discovers and opens local projects through the host" "Filesystem"
bridgeUsesMachine = bridge -> machineData "Resolves instances and persists desktop bridge preferences and staged drafts" "Local files"
serverUsesMachine = server -> machineData "Persists registries, device grants, jobs, claims, and orchestration observations" "Local files"
cliUsesMachine = cli -> machineData "Reads and administers local registries, credentials, and coordination state" "Local files"
mcpUsesMachine = mcp -> machineData "Discovers the local host and store/source bindings" "Local files"
bridgeRunsMigration = bridge -> migrator "Starts the packaged import or migration job" "Child process"
migrationWritesStore = migrator -> tickets "Imports normalized tickets, attachments, and mappings and records them in Git" "Filesystem / Git"
apiUsesBridge = webApi -> bridge "Sends scoped API operations" "HTTP(S)"
changesUseBridge = webChanges -> bridge "Subscribes to live changes or reconnects from a cursor" "WebSocket / HTTP long poll"
terminalUsesBridge = webTerminal -> bridge "Attaches terminal input, output, and replay" "WebSocket"
bridgeUsesTrust = bridge -> serverTrust "Presents the appropriate transport and request authority" "HTTP(S) / WebSocket"
sourceWritesGit = serverSources -> tickets "Persists the authoritative local Git operation" "Filesystem / Git"
reconcileReadsGit = serverIndex -> tickets "Observes filesystem edits and reads affected ticket paths" "Filesystem notifications"
reconcileWritesIndex = serverIndex -> searchIndex "Applies changes to SQLite" "SQLite"
eventsDeliverBridge = serverEvents -> bridge "Replays or delivers events to subscribed clients" "WebSocket / HTTP long poll"
scheduleReadsSettings = serverSchedule -> checkoutData "Reads schedules and persists occurrence records" "Local settings files"
orchUsesState = serverOrch -> machineData "Reads and writes target, session, gate, and run observations" "Local files"
orchUsesPlan = serverOrch -> checkoutData "Reads shared plan definitions and checkout policy" "Filesystem / Git"
resourcesUseMachine = serverResources -> machineData "Persists local backend bindings and leases" "Local files"
jobsUseMachine = serverJobs -> machineData "Persists job and process observations" "Local files"

// HS2-H0T69J: library containers linked into the runtime processes
serverLinksCore = server -> coreLib "Links the ticket model, store, providers, sync and index" "Rust crate dependency"
cliLinksCore = cli -> coreLib "Links the same ticket engine for direct store operations" "Rust crate dependency"
mcpLinksCore = mcp -> coreLib "Links the ticket engine for serverless mode" "Rust crate dependency"
serverLinksOrch = server -> orchLib "Links orchestration, coordination, resource claims and jobs" "Rust crate dependency"
cliLinksOrch = cli -> orchLib "Links orchestration and coordination for headless commands" "Rust crate dependency"
orchLinksCore = orchLib -> coreLib "Builds on ticket store, claims and settings" "Rust crate dependency"
