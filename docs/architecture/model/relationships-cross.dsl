cliStoreCmdsCore = cliStoreCmds -> coreLib "Initializes, syncs, reindexes and merges through the core" "Rust call"
cliStoreCmdsStore = cliStoreCmds -> tickets "Creates, repairs and syncs the store repository" "Filesystem / Git"
