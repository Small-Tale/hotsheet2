cliResourcesServer = cliResources -> server "Renews or releases through the renewal-token route" "HTTPS"
cliNotifyMachine = cliNotify -> machineData "Reads and writes notifier and remote-change configuration" "Local files"
mcpEntryServer = mcpEntry -> server "Opens the project to get a checkout id" "HTTP"
mcpEntryMachine = mcpEntry -> machineData "Reads checkouts.json and instance records" "Local files"
mcpCoreBackendCore = mcpCoreBackend -> coreLib "Runs ticket operations in-process" "Rust call"
mcpCoreBackendStore = mcpCoreBackend -> tickets "Reads and commits the admitted store" "Filesystem / Git"
mcpHttpBackendServer = mcpHttpBackend -> server "Calls checkout and machine routes" "HTTP"
mcpPresenceServer = mcpPresence -> server "Upserts and deletes /mcp-presence leases" "HTTP"
migImportCore = migImport -> coreLib "Writes tickets through the core writer" "Rust call"
migImportStore = migImport -> tickets "Writes tickets, attachments, checkpoints and the receipt" "Filesystem / Git"
serverLinksCliCoordination = server -> cliCoordination "Links the coordination pool for its routes" "Rust crate dependency"
serverLinksCliOrchestration = server -> cliOrchestration "Links OrchestrationRuntime for its routes" "Rust crate dependency"
serverLinksCliRemotes = server -> cliRemotes "Links the remote server registry" "Rust crate dependency"
mcpCoreBackendKick = mcpCoreBackend -> server "Posts /sync/kick after serverless writes" "HTTP"

// HS2-AH9HAK: core
serverUsesCoreOutbox = server -> coreOutbox "Admits Jira field edits and runs the dispatch loop when HOTSHEET_JIRA_WRITE_BEHIND=1" "Rust call"
serverUsesCoreProviders = server -> coreProviderContract "Routes checkout ticket operations and explicit transfers" "Rust call"
cliUsesCoreProviders = cli -> coreProviderContract "Runs direct provider operations and explicit transfers" "Rust call"
serverRunsCoreSync = server -> coreSync "Runs sync cycles and asks for AI help on a stall" "Rust call"
cliRunsCoreSync = cli -> coreSync "Runs hotsheet-cli sync and stale-lock recovery" "Rust call"
serverUsesCoreIndex = server -> coreIndex "Restores, reconciles and queries the store index" "Rust call"
cliUsesCoreIndex = cli -> coreIndex "Queries or rebuilds the store index" "Rust call"
cliRunsCoreMerge = cli -> coreMerge "hotsheet-cli merge-driver, started by Git, merges one ticket file" "Rust call"
coreOutboxUsesMachine = coreOutbox -> machineData "Persists HOTSHEET_HOME/outbox/<store id>.sqlite" "SQLite"
coreCheckoutsUseMachine = coreCheckouts -> machineData "Reads and writes checkouts.json under checkouts.json.lock" "Local files"
coreConfigUsesMachine = coreProviderConfig -> machineData "Reads and writes providers.json under providers.json.lock" "Local files"
coreSecretsUseMachine = coreSecrets -> machineData "Writes keys.json metadata and encrypted machine-secrets envelopes" "Local files"
coreSettingsUseMachine = coreSettings -> machineData "Reads and writes global settings.json and settings-locks" "Local files"
coreRemotesUseMachine = coreRemoteServers -> machineData "Reads and writes remotes.json and server-identity.json" "Local files"
coreTlsUsesMachine = coreTls -> machineData "Writes CA, server and device certificates and the revoked list" "Local files"
coreJournalUsesMachine = coreProcessJournal -> machineData "Writes one JSON record per launch under processes/" "Local files"
