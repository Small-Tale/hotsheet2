// cli relationships. Owned by HS2-TW2DKM. Both endpoints belong to this area,
// or one endpoint is an external system or person. Edges between areas go in
// relationships-cross.dsl. Included after every element, so order does not matter.

toolCallsMcp = aiTool -> mcp "Invokes checkout tools" "stdio JSON-RPC"
cliUsesGithub = cli -> github "Runs supported provider and CI operations" "HTTPS"
cliUsesGitlab = cli -> gitlab "Runs supported provider and CI operations" "HTTPS"
cliUsesJira = cli -> jira "Runs supported provider operations" "HTTPS"
cliSyncsGit = cli -> gitRemote "Initializes, links, and syncs repositories on request" "Git"
cliUsesOs = cli -> osServices "Uses native credentials and starts local tools" "Native OS APIs"
cliRunsTool = cli -> aiTool "Starts compatible tools for headless launch and drive operations" "Process launch"
migrationReadsLegacy = migrator -> legacy "Exports from a copy of the old database" "Node.js / PGLite"

// ---- HS2-TW2DKM component edges: CLI ----
contributorRunsCliEntry = developer -> cliEntry "Runs hotsheet-cli commands" "Terminal"
cliEntryStore = cliEntry -> cliStoreCmds "Dispatches the Store group" "In-process call"
cliEntryTickets = cliEntry -> cliTicketCmds "Dispatches the Tickets group" "In-process call"
cliEntryClaims = cliEntry -> cliClaimCmds "Dispatches the Claims group" "In-process call"
cliEntryProviders = cliEntry -> cliProviderCmds "Dispatches the Providers group" "In-process call"
cliEntrySetup = cliEntry -> cliSetupCmds "Dispatches the Setup group" "In-process call"
cliEntryHook = cliEntry -> cliPermissionHook "Dispatches permission-hook and hook-diagnose" "In-process call"
cliEntryServer = cliEntry -> cliHostClient "Dispatches the Server group" "In-process call"
cliEntryCoordination = cliEntry -> cliCoordination "Dispatches the Coordination group" "In-process call"
cliEntryOrchestration = cliEntry -> cliOrchestration "Dispatches the Orchestration group" "In-process call"
cliEntryRemotes = cliEntry -> cliRemotes "Dispatches the Remote group" "In-process call"
cliEntryJobs = cliEntry -> cliJobs "Dispatches the Jobs group" "In-process call"
cliEntryResources = cliEntry -> cliResources "Dispatches the Resources group" "In-process call"
cliEntryNotify = cliEntry -> cliNotify "Dispatches the Notify group and remote-change" "In-process call"
cliEntryPostCommand = cliEntry -> cliPostCommand "Watches transitions before, kicks host sync after every command" "In-process call"
cliPostCommandFindsHost = cliPostCommand -> cliHostClient "Lists live hosts under this home" "In-process call"
cliStoreImports = cliStoreCmds -> migImport "Runs import, attachment diagnosis and recovery" "In-process call"
cliStoreAsksHosts = cliStoreCmds -> cliHostClient "Asks live servers to dry-run and remove a checkout" "In-process call"
cliSetupStartsHost = cliSetupCmds -> cliHostClient "Ensures the machine host for launch and notifies running servers" "In-process call"
cliHookFindsRoute = cliPermissionHook -> cliHostClient "Re-reads the live route-back server for each hook" "In-process call"
cliRemotesUseHost = cliRemotes -> cliHostClient "Calls host remote-auth routes for session approval" "In-process call"
cliOrchestrationUsesRemotes = cliOrchestration -> cliRemotes "Calls targets on paired remote servers" "In-process call"
cliOrchestrationStartsJobMonitor = cliOrchestration -> cliJobs "Starts a detached job monitor for linked gates" "Child process"
cliProviderUsesGithub = cliProviderCmds -> github "Runs GitHub Issues, sign-in and webhook operations" "HTTPS"
cliProviderUsesGitlab = cliProviderCmds -> gitlab "Runs GitLab Issues operations" "HTTPS"
cliProviderUsesJira = cliProviderCmds -> jira "Runs Jira operations" "HTTPS"
cliProviderUsesKeychain = cliProviderCmds -> osServices "Stores and reads provider keys" "OS credential store"
cliJobsWatchGithub = cliJobs -> github "Reads Actions runs" "HTTPS"
cliJobsWatchGitlab = cliJobs -> gitlab "Reads pipelines" "HTTPS"
cliJobsWatchCi = cliJobs -> ciServices "Reads builds and pipelines" "HTTPS"
cliStoreSyncsGit = cliStoreCmds -> gitRemote "Adds origin, fetches, rebases and pushes the ticket store" "Git"
cliCoordinationUsesGit = cliCoordination -> gitRemote "Fetches and prunes merge-pending branches and reads CI-gate commits" "Git"
cliSetupRunsTool = cliSetupCmds -> aiTool "Launches an interactive tool or drives trigger and work turns" "Process launch"
toolRunsPermissionHook = aiTool -> cliPermissionHook "Runs hotsheet-cli permission-hook for each hook event" "Process stdin/stdout"
cliNotifySends = cliNotify -> notifierServices "Sends test and configured notifications" "HTTPS / local adapters"
cliResourcesUseShared = cliResources -> sharedClaims "Acquires and renews leases on a configured backend" "HTTPS / Git refs"
cliRemotesUseKeychain = cliRemotes -> osServices "Stores paired-server credentials" "OS credential store"

// ---- HS2-TW2DKM component edges: MCP ----
toolCallsMcpEntry = aiTool -> mcpEntry "Sends JSON-RPC lines and reads replies" "stdio JSON-RPC"
mcpEntryTools = mcpEntry -> mcpTools "Handles initialize, tools/list, tools/call and ping" "In-process call"
mcpEntryPresence = mcpEntry -> mcpPresence "Starts presence on initialize, stops it on EOF" "Thread"
mcpEntryFindsHost = mcpEntry -> cliHostClient "Ensures or attaches to the machine host" "In-process call"
mcpToolsDomain = mcpTools -> mcpDomainTools "Delegates hotsheet_targets, hotsheet_remotes and hotsheet_resource_claim" "In-process call"
mcpToolsCore = mcpTools -> mcpCoreBackend "Sends requests in serverless mode" "Backend trait"
mcpToolsHttp = mcpTools -> mcpHttpBackend "Sends requests in explicit-server and project modes" "Backend trait"
mcpDomainCore = mcpDomainTools -> mcpCoreBackend "Sends requests in serverless mode" "Backend trait"
mcpDomainHttp = mcpDomainTools -> mcpHttpBackend "Sends requests in server modes" "Backend trait"
mcpCoreKicksHost = mcpCoreBackend -> cliPostCommand "Watches transitions and kicks host sync after writes" "In-process call"
mcpCoreUsesCoordination = mcpCoreBackend -> cliCoordination "Answers worker, plan and speculation requests" "In-process call"
mcpCoreUsesOrchestration = mcpCoreBackend -> cliOrchestration "Answers target requests" "In-process call"
mcpCoreUsesRemotes = mcpCoreBackend -> cliRemotes "Answers remote registry requests" "In-process call"
mcpPresenceFindsHost = mcpPresence -> cliHostClient "Relocates to the registry server" "In-process call"

// ---- HS2-TW2DKM component edges: migrator ----
migBinarySpawnsExporter = migBinary -> migExporter "Spawns node export.mjs and reads NDJSON progress" "Child process"
migExporterReadsLegacy = migExporter -> legacy "Copies and opens the PGLite datadir" "Node.js / PGLite"
migBinaryImports = migBinary -> migImport "Imports, verifies and records completion" "In-process call"
migImportPushesBackup = migImport -> gitRemote "Pushes and verifies the backup origin" "Git"

// ---- HS2-TW2DKM component edges: additional dynamic-view hops ----
cliStoreRunsSetup = cliStoreCmds -> cliSetupCmds "Runs detected AI-tool setup during bootstrap" "In-process call"
cliHookAnswersTool = cliPermissionHook -> aiTool "Prints the hook decision or question answer" "stdout JSON"
contributorRunsMigrate = developer -> migBinary "Runs hotsheet-migrate" "Terminal"
