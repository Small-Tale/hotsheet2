// server relationships. Owned by HS2-P27EJM. Both endpoints belong to this area,
// or one endpoint is an external system or person. Edges between areas go in
// relationships-cross.dsl. Included after every element, so order does not matter.

serverUsesGithub = server -> github "Routes native Issues requests and observes supported Actions jobs" "HTTPS"
githubNotifiesServer = github -> server "Delivers configured repository events" "Webhook"
serverUsesGitlab = server -> gitlab "Routes native Issues requests and observes supported CI jobs" "HTTPS"
serverUsesJira = server -> jira "Routes native issue and advisory claim operations" "HTTPS"
serverSyncsGit = server -> gitRemote "Fetches and publishes eligible linked store changes" "Git"
serverUsesOs = server -> osServices "Uses native file events, credentials, and process facilities" "Native OS APIs"
serverUsesBroker = server -> broker "Starts or reconnects to detached PTY owners and relays input and output" "Local IPC"
serverUsesRelay = server -> launchRelay "Requests background terminal launch when the relay is available" "Local IPC"
relayLaunchesBroker = launchRelay -> broker "Starts the detached terminal owner when needed" "Process launch"
brokerRunsTool = broker -> aiTool "Hosts interactive AI tools and shell processes" "PTY"
serverDrivesTool = server -> aiTool "Launches or drives provider sessions and receives permission callbacks" "Provider-specific process / local interfaces"
serverPublishesStandby = server -> standby "Writes bounded display snapshots with no server credential" "File"
saverReadsStandby = saver -> standby "Watches and reads the latest snapshot" "File"
trustAdmitsTickets = serverTrust -> serverTickets "Admits a scoped ticket operation" "Rust / Axum"
trustAdmitsTerminal = serverTrust -> serverTerminal "Admits terminal operations and stream attachment" "Rust / Axum"
trustAdmitsOrch = serverTrust -> serverOrch "Admits authorized orchestration actions" "Rust / Axum"
ticketApiUsesSource = serverTickets -> serverSources "Routes by qualified identity and capability" "Rust provider contract"
ticketApiUsesIndex = serverTickets -> serverIndex "Reads local indexed pages and updates affected projections" "Rust / SQLite"
ticketApiPublishes = serverTickets -> serverEvents "Publishes ticket and claim invalidations" "Rust event bus"
sourceUsesGithub = serverSources -> github "Delegates native Issues operations" "HTTPS"
sourceUsesGitlab = serverSources -> gitlab "Delegates native Issues operations" "HTTPS"
sourceUsesJira = serverSources -> jira "Routes Jira operations and supported queued writes" "HTTPS"
reconcilePublishes = serverIndex -> serverEvents "Publishes changes after reconciliation" "Rust event bus"
scheduleUsesTickets = serverSchedule -> serverTickets "Checks the command provenance and creates one Up Next ticket if eligible" "Rust"
scheduleClaimsTicket = serverSchedule -> serverTickets "Claims the exact scheduled ticket for the session worker" "Rust / Git ticket lease"
scheduleHandsOff = serverSchedule -> serverDrive "Requests the selected exact-ticket AI handoff" "Rust"
driveUsesTerminal = serverDrive -> serverTerminal "Launches or uses the eligible terminal and worker identity" "Rust"
driveUsesTool = serverDrive -> aiTool "Sends a supported provider turn and tracks its outcome" "Provider-specific protocol"
terminalUsesBroker = serverTerminal -> broker "Uses detached Unix PTY ownership" "Local IPC"
terminalObservesTool = serverTerminal -> aiTool "Hosts tool processes in the in-process PTY path" "PTY"
orchUsesTrust = serverOrch -> serverTrust "Evaluates operation-specific authorization" "Rust authorization checks"
orchUsesTickets = serverOrch -> serverTickets "Observes and links target work and its readiness" "Rust"
orchUsesDrive = serverOrch -> serverDrive "Places or reuses permitted AI sessions" "Rust / authorized host operations"
orchUsesJobs = serverOrch -> serverJobs "Reads or starts supported validation or job operations" "Rust"
jobsUseGithub = serverJobs -> github "Observes supported Actions runs" "HTTPS"
jobsUseGitlab = serverJobs -> gitlab "Observes supported CI runs" "HTTPS"
orchUsesResources = serverOrch -> serverResources "Observes lease availability before placement" "Rust lease service"
resourcesUseRemote = serverResources -> sharedClaims "Uses configured shared leases" "HTTPS / subprocess adapter"
resourcesUseGit = serverResources -> gitRemote "Reads or updates leases in the configured Git ref backend" "Git"
jobsUseCi = serverJobs -> ciServices "Observes configured Buildkite and CircleCI jobs" "HTTPS"
notifyUsesEvents = serverNotify -> serverEvents "Publishes workspace notification state" "Rust event bus"
notifySends = serverNotify -> notifierServices "Delivers configured notification events" "Configured notifier protocols"
notifyWritesStandby = serverNotify -> standby "Publishes a bounded projection for the screen saver" "JSON file"

// Deep baseline (HS2-P27EJM): process, transport and admission
lifecycleBuildsTls = serverLifecycle -> serverTls "Builds the HTTPS or mTLS acceptor for an off-loopback listener" "Rust / rustls"
lifecycleServesMiddleware = serverLifecycle -> serverMiddleware "Serves one router on the remote and loopback listeners" "Axum"
lifecycleHostsStores = serverLifecycle -> serverHosting "Registers the primary and configured stores and publishes their instance files" "Rust"
lifecycleStartsTerminals = serverLifecycle -> serverTerminal "Connects the broker client and resumes surviving terminal monitors before serving" "Rust"
lifecycleStartsSync = serverLifecycle -> serverSync "Starts the sync loop and flushes background commits at shutdown" "Tokio task"
lifecycleLoadsPermissions = serverLifecycle -> serverPermissions "Loads remembered rules on a thread after bind" "std thread"
tlsAdmits = serverTls -> serverTrust "Marks the request certificate-authenticated with its fingerprint after the ACL check" "Request extension"
middlewareAdmits = serverMiddleware -> serverTrust "Runs the bearer, certificate or session check for protected routes" "Axum route layer"
middlewareStampsCursor = serverMiddleware -> serverEvents "Reads the replay cursor before the handler and stamps the response" "Rust"
trustUsesPairing = serverTrust -> serverPairing "Validates a session cookie with Origin and CSRF, or a paired bearer" "Rust"
pairingPublishes = serverPairing -> serverEvents "Publishes pairing-request and grant changes without identities" "Rust event bus"
eventsUsePairing = serverEvents -> serverPairing "Rechecks remote sessions and hides manager-only events" "Rust"
eventsUseHosting = serverEvents -> serverHosting "Holds a presence lease per change stream and checkout" "Rust"
ticketApiUsesHosting = serverTickets -> serverHosting "Resolves the hosted store entry and its index" "Rust"
hostingUsesIndex = serverHosting -> serverIndex "Opens projections and watchers for hosted stores" "Rust / SQLite"

// Deep baseline (HS2-P27EJM): sources and change propagation
trustAdmitsWriteBehind = serverTrust -> serverWriteBehind "Admits queued Jira edits and outbox actions" "Rust / Axum"
writeBehindUsesSources = serverWriteBehind -> serverSources "Resolves the Jira connection adapter" "Rust provider contract"
writeBehindUsesJira = serverWriteBehind -> jira "Reads back and updates issue fields with the concurrency token" "HTTPS"
writeBehindPublishes = serverWriteBehind -> serverEvents "Publishes an update per claimed and settled operation" "Rust event bus"
advisoryUsesSources = serverAdvisory -> serverSources "Uses the provider's advisory claim capability" "Rust provider contract"
sourcesUseCredentials = serverSources -> serverCredentials "Reads managed sign-in secrets" "Rust"
credentialsUseOs = serverCredentials -> osServices "Reads credentials from the OS credential store" "Native OS APIs"
githubDeliversWebhook = github -> serverWebhooks "Delivers signed issue events" "HTTPS webhook"
webhooksPublish = serverWebhooks -> serverEvents "Publishes provider ticket invalidations" "Rust event bus"
ticketApiKicksSync = serverTickets -> serverSync "Kicks a prompt sync pass after a store write" "std mpsc"
syncUsesGit = serverSync -> gitRemote "Fetches, integrates and pushes hosted stores" "Git"
syncPublishes = serverSync -> serverEvents "Announces store and group-registry sync state" "Rust event bus"
livePublishes = serverLive -> serverEvents "Pushes changed live snapshots and activity" "Rust event bus"
repositoryPublishes = serverRepository -> serverEvents "Publishes repository invalidations for open checkouts" "Rust event bus"
repositoryUsesOs = serverRepository -> osServices "Launches host review tools for host-trusted callers" "Process launch"
webhooksUseSources = serverWebhooks -> serverSources "Looks up the connection's webhook secret" "Rust"

// Deep baseline (HS2-P27EJM): execution
trustAdmitsPermissions = serverTrust -> serverPermissions "Admits hook asks and client answers" "Rust / Axum"
permissionsPublish = serverPermissions -> serverEvents "Publishes permission_asked and permission_resolved" "Rust event bus"
permissionsUseOs = serverPermissions -> osServices "Reads the rule-vault key from the OS credential store" "Native OS APIs"
driveUsesPermissions = serverDrive -> serverPermissions "Parks driven approvals on the bridge" "Rust"
driveUsesAiTools = serverDrive -> serverAiTools "Prepares and runs a safe trigger per turn" "Rust"
aiToolsUseTool = serverAiTools -> aiTool "Spawns tools or speaks their app-server, channel or ACP protocol" "Process / JSON-RPC"
aiToolsUsePlugins = serverAiTools -> serverPlugins "Builds drives from manifest declarations" "Rust"
distWorkClaims = serverDistWork -> serverTickets "Claims tickets across hosted stores with a Git remote" "Rust"
distWorkDrives = serverDistWork -> serverAiTools "Runs one safe trigger per claimed ticket" "Rust"
distWorkUsesPermissions = serverDistWork -> serverPermissions "Parks driven approvals on the bridge" "Rust"
terminalUsesRelay = serverTerminal -> launchRelay "Asks the relay to start a broker when the LaunchAgent is installed" "Unix socket"
terminalPublishes = serverTerminal -> serverEvents "Publishes terminal halt, question, AI-connection and permission-rule events" "Rust event bus"
terminalUsesAiTools = serverTerminal -> serverAiTools "Launches connected AI tools and follows transcript or rollout usage" "Rust"
brokerReportsTerminal = broker -> serverTerminal "Answers requests and streams replay, output and size frames" "Local IPC"

// Deep baseline (HS2-P27EJM): host support and notifications
orchUsesHostHealth = serverOrch -> serverHostHealth "Reads capacity before admitting placement" "Rust"
hostHealthUsesOs = serverHostHealth -> osServices "Samples CPU, memory and process facts" "Native OS APIs"
eventsFeedNotify = serverEvents -> serverNotify "Delivers every bus event to the router subscription" "Tokio broadcast"
notifyRefreshesLive = serverNotify -> serverLive "Rebuilds live snapshots on the minute tick" "Rust"
notifyUsesNotifiers = serverNotify -> serverNotifiers "Dispatches matched messages" "Rust"
notifiersSend = serverNotifiers -> notifierServices "Delivers to speak, ntfy, email, Slack, Teams, Twilio, webhook or external notifiers" "HTTPS / SMTP / subprocess"

// Deep baseline (HS2-P27EJM): broker, relay and saver internals
brokerSocketOwns = brokerService -> brokerSocket "Binds and holds the private socket" "Rust"
brokerServesTerminals = brokerService -> brokerManager "Opens, lists, reads, writes, clears and kills terminals" "Rust"
brokerManagerOwns = brokerManager -> brokerTerminals "Spawns and holds each PTY terminal" "Rust"
brokerSizesTerminals = brokerTerminals -> brokerSizing "Applies the arbitrated viewer size" "Rust"
brokerTerminalsRunTool = brokerTerminals -> aiTool "Runs the shell or AI tool in the PTY" "PTY"
serverCallsBrokerService = serverTerminal -> brokerService "Sends requests and stream frames over the broker socket" "Unix socket"
relayUsesLauncher = relayService -> relayLauncher "Validates and hands over a launch request" "Rust"
relayStartsBroker = relayLauncher -> broker "Spawns the broker process detached" "Process launch"
relayChecksBootstrap = relayService -> relayBootstrap "Reports its namespace health in hello" "Rust"
serverCallsRelay = serverTerminal -> relayService "Requests a broker launch" "Unix socket"
relayAgentDefines = relayAgent -> relayService "Installs the LaunchAgent that starts the listener" "launchd"
relayAgentUsesOs = relayAgent -> osServices "Loads and unloads the agent with launchctl" "launchctl"
saverWatcherReads = saverWatcher -> standby "Watches the directory and rereads the snapshot" "File"
saverWatcherFeedsView = saverWatcher -> saverView "Delivers the snapshot text" "Swift"
