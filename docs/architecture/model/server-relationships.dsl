// server relationships. Owned by HS2-P27EJM. Both endpoints belong to this area,
// or one endpoint is an external system or person. Edges between areas go in
// relationships-cross.dsl. Included after every element, so order does not matter.

serverUsesGithub = server -> github "Routes native Issues requests and observes supported Actions jobs" "HTTPS"
githubNotifiesServer = github -> server "Delivers configured repository events" "Webhook"
serverUsesGitlab = server -> gitlab "Routes native Issues requests and observes supported CI jobs" "HTTPS"
serverUsesJira = server -> jira "Routes native issue and advisory claim operations" "HTTPS"
serverSyncsGit = server -> gitRemote "Fetches and publishes eligible linked store changes" "Git"
serverUsesOs = server -> osServices "Uses native file events, credentials, and process facilities" "Native OS APIs"
serverUsesBroker = server -> broker "Starts or reconnects to detached PTY owners and relays input and output" "Local IPC"
serverUsesRelay = server -> launchRelay "Requests background terminal launch when the relay is available" "Local IPC"
relayLaunchesBroker = launchRelay -> broker "Starts the detached terminal owner when needed" "Process launch"
brokerRunsTool = broker -> aiTool "Hosts interactive AI tools and shell processes" "PTY"
serverDrivesTool = server -> aiTool "Launches or drives provider sessions and receives permission callbacks" "Provider-specific process / local interfaces"
serverPublishesStandby = server -> standby "Writes bounded display snapshots with no server credential" "File"
saverReadsStandby = saver -> standby "Watches and reads the latest snapshot" "File"
trustAdmitsTickets = serverTrust -> serverTickets "Admits a scoped ticket operation" "Rust / Axum"
trustAdmitsTerminal = serverTrust -> serverTerminal "Admits terminal operations and stream attachment" "Rust / Axum"
trustAdmitsOrch = serverTrust -> serverOrch "Admits authorized orchestration actions" "Rust / Axum"
ticketApiUsesSource = serverTickets -> serverSources "Routes by qualified identity and capability" "Rust provider contract"
ticketApiUsesIndex = serverTickets -> serverIndex "Reads local indexed pages and updates affected projections" "Rust / SQLite"
ticketApiPublishes = serverTickets -> serverEvents "Publishes ticket and claim invalidations" "Rust event bus"
sourceUsesGithub = serverSources -> github "Delegates native Issues operations" "HTTPS"
sourceUsesGitlab = serverSources -> gitlab "Delegates native Issues operations" "HTTPS"
sourceUsesJira = serverSources -> jira "Routes Jira operations and supported queued writes" "HTTPS"
reconcilePublishes = serverIndex -> serverEvents "Publishes changes after reconciliation" "Rust event bus"
scheduleUsesTickets = serverSchedule -> serverTickets "Checks the command provenance and creates one Up Next ticket if eligible" "Rust"
scheduleClaimsTicket = serverSchedule -> serverTickets "Claims the exact scheduled ticket for the session worker" "Rust / Git ticket lease"
scheduleHandsOff = serverSchedule -> serverDrive "Requests the selected exact-ticket AI handoff" "Rust"
driveUsesTerminal = serverDrive -> serverTerminal "Launches or uses the eligible terminal and worker identity" "Rust"
driveUsesTool = serverDrive -> aiTool "Sends a supported provider turn and tracks its outcome" "Provider-specific protocol"
terminalUsesBroker = serverTerminal -> broker "Uses detached Unix PTY ownership" "Local IPC"
terminalObservesTool = serverTerminal -> aiTool "Hosts tool processes in the in-process PTY path" "PTY"
orchUsesTrust = serverOrch -> serverTrust "Evaluates operation-specific authorization" "Rust authorization checks"
orchUsesTickets = serverOrch -> serverTickets "Observes and links target work and its readiness" "Rust"
orchUsesDrive = serverOrch -> serverDrive "Places or reuses permitted AI sessions" "Rust / authorized host operations"
orchUsesJobs = serverOrch -> serverJobs "Reads or starts supported validation or job operations" "Rust"
jobsUseGithub = serverJobs -> github "Observes supported Actions runs" "HTTPS"
jobsUseGitlab = serverJobs -> gitlab "Observes supported CI runs" "HTTPS"
orchUsesResources = serverOrch -> serverResources "Observes lease availability before placement" "Rust lease service"
resourcesUseRemote = serverResources -> sharedClaims "Uses configured shared leases" "HTTPS / subprocess adapter"
resourcesUseGit = serverResources -> gitRemote "Reads or updates leases in the configured Git ref backend" "Git"
jobsUseCi = serverJobs -> ciServices "Observes configured Buildkite and CircleCI jobs" "HTTPS"
notifyUsesEvents = serverNotify -> serverEvents "Publishes workspace notification state" "Rust event bus"
notifySends = serverNotify -> notifierServices "Delivers configured notification events" "Configured notifier protocols"
notifyWritesStandby = serverNotify -> standby "Publishes a bounded projection for the screen saver" "JSON file"
