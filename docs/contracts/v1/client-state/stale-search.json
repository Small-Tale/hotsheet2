{
  "format": "hotsheet-client-state/v1",
  "id": "newer-search-response-wins",
  "kind": "stale_search",
  "initial": {
    "views": [
      { "id": "alpha", "query": "Alpha" },
      { "id": "beta", "query": "Beta" }
    ]
  },
  "steps": [
    { "action": "request", "view": "alpha", "expect": { "visible": [], "selected_view": "alpha" } },
    { "action": "request", "view": "beta", "expect": { "visible": [], "selected_view": "beta" } },
    {
      "action": "resolve",
      "view": "beta",
      "rows": [{ "slug": "HS2-B", "title": "Beta" }],
      "expect": { "visible": ["HS2-B"], "selected_view": "beta" }
    },
    {
      "action": "resolve",
      "view": "alpha",
      "rows": [{ "slug": "HS2-A", "title": "Alpha" }],
      "expect": { "visible": ["HS2-B"], "selected_view": "beta" }
    },
    { "action": "request", "view": "alpha", "expect": { "visible": [], "selected_view": "alpha" } },
    {
      "action": "resolve",
      "view": "alpha",
      "rows": [{ "slug": "HS2-A", "title": "Alpha" }],
      "expect": { "visible": ["HS2-A"], "selected_view": "alpha" }
    }
  ]
}
