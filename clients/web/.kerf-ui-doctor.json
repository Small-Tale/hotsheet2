{
  "$schema": "./node_modules/@kerfjs/ui/doctor/config.schema.json",
  "schemaVersion": 1,
  "mode": "full",
  "ownership": "component",
  "ownershipContext": "any-package",
  "implicitComponentOwnership": true,
  "ownershipGroups": [
    {
      "styleSources": ["src/style.css"],
      "sources": ["src/main.tsx", "src/app/"]
    },
    {
      "styleSources": ["src/ux-demo/style.css"],
      "sources": ["src/ux-demo/"]
    },
    {
      "styleSources": ["src/dev-review/dev-review.css"],
      "sources": ["src/dev-review/"]
    }
  ],
  "stages": {
    "catalog": true,
    "typescript": true,
    "eslint": true,
    "analyzer": true,
    "browser": false
  },
  "cache": true,
  "failOn": "warning",
  "suppressions": []
}
