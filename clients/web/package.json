{
  "name": "hotsheet-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stable-dev.mjs",
    "dev:hot": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-production-bundle.mjs",
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write . ../../migrator ../../spikes/kerf-webawesome ../../docs ../../.github ../../opencode.json && cargo fmt --all --manifest-path ../../Cargo.toml",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check . ../../migrator ../../spikes/kerf-webawesome ../../docs ../../.github ../../opencode.json && cargo fmt --all --check --manifest-path ../../Cargo.toml",
    "lint": "npm run format:check && eslint . --max-warnings 0 && npm run catalog:check",
    "catalog:sync": "node scripts/sync-component-catalog-extension.mjs",
    "catalog:check": "node scripts/sync-component-catalog-extension.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "cargo build --manifest-path ../../Cargo.toml -p hotsheet-cli -p hotsheet-server --bins && playwright test",
    "test:performance": "HOTSHEET_WEB_PERFORMANCE_GATE=1 playwright test tests/providers.spec.ts --workers=1 -g 'projects Up Next immediately|projects a newly created ticket'",
    "stress:scale": "node scripts/scale-stress.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.12.0",
    "@kerfjs/ui": "5.0.0-beta.23",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.5",
    "kerfjs": "5.0.0-beta.23",
    "lucide": "1.43.0",
    "marked": "^18.0.11",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "22.17.2",
    "@types/ws": "^8.18.1",
    "domotion-svg": "^0.24.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-kerfjs": "^4.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "html2canvas": "^1.4.1",
    "prettier": "^3.9.8",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
