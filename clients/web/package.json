{
  "name": "hotsheet-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stable-dev.mjs",
    "dev:hot": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-production-bundle.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "playwright test tests/providers.spec.ts -g 'projects Up Next immediately'"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.11.0",
    "hono": "^4.13.5",
    "kerfjs": "4.4.0",
    "lucide": "1.34.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "22.17.2",
    "domotion-svg": "^0.24.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-kerfjs": "^4.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "html2canvas": "^1.4.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
