{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hot Sheet 2",
  "version": "0.1.0",
  "identifier": "com.smalltale.hotsheet2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": [
      "binaries/node",
      "binaries/hotsheet-server",
      "binaries/hotsheet-cli",
      "binaries/hotsheet-migrate",
      "binaries/hotsheet-mcp"
    ],
    "resources": { "resources/": "" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
