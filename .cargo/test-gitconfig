# HS2-M269HC: the global Git config for every process cargo or nextest starts
# (`.cargo/config.toml` sets GIT_CONFIG_GLOBAL). Tests get a synthetic identity like
# CI's, never a developer's signing, hooks or credential settings, and Git never starts
# detached `maintenance run --auto` children that outlive a test (a nextest LEAK).
[user]
	name = Hot Sheet test
	email = test@example.invalid
[maintenance]
	auto = false
[gc]
	auto = 0
# HS2-726EXJ: pin the initial branch. Git's built-in default differs by version (Apple
# Git 2.54 here, Linux CI's git elsewhere), so a test that assumed `main` after an
# owner-aware `git init` passed locally and failed in CI. `master` matches CI, so a
# branch-name assumption fails locally first.
[init]
	defaultBranch = master
