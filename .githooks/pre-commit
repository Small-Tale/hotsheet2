#!/bin/bash
# HS2-CD3D2T: fast staged whitespace and formatting gate.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
# HS2-9EGWC4: Hot Sheet commits its project group registry alone (`git commit --only`, so the
# index seen here holds just those paths). Group entries are data, not code: whitespace is the
# whole gate for them, and the web format check (64-78 s measured) would stall every group change.
staged=$(git diff --cached --name-only --no-renames)
if [[ -n "$staged" ]] && ! grep -qvE '^\.hotsheet2/groups/[^/]+\.json$' <<<"$staged"; then
  exit 0
fi
(
  cd clients/web
  zsh -ic 'npm run format:check'
)
